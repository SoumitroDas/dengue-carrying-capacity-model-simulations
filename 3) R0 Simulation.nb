Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global'*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ro", "[", 
   RowBox[{"A_", ",", "W_"}], "]"}], "=", 
  SqrtBox[
   FractionBox[
    RowBox[{"Lm", "*", "Lh", "*", "bh", "*", 
     RowBox[{"(", 
      RowBox[{"\[ExponentialE]", "^", 
       RowBox[{"-", 
        RowBox[{"(", "A", ")"}]}]}], ")"}], "*", "bm", "*", 
     RowBox[{"(", 
      RowBox[{"\[ExponentialE]", "^", 
       RowBox[{"-", 
        RowBox[{"(", "A", ")"}]}]}], ")"}], "*", "alph", "*", "alpm", "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"(", 
        FractionBox["12.58", 
         RowBox[{"K", "*", 
          RowBox[{"(", 
           RowBox[{"\[ExponentialE]", "^", 
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{"W", "+", "A"}], ")"}]}]}], ")"}]}]], ")"}]}], ")"}]}], 
    RowBox[{"mum", "*", 
     RowBox[{"(", 
      RowBox[{"\[ExponentialE]", "^", 
       RowBox[{"(", "W", ")"}]}], ")"}], "*", "muh", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"mum", "*", 
         RowBox[{"(", 
          RowBox[{"\[ExponentialE]", "^", 
           RowBox[{"(", "W", ")"}]}], ")"}]}], ")"}], "+", "phim"}], ")"}], 
     "*", 
     RowBox[{"(", 
      RowBox[{"muh", "+", "phih", "+", "gh"}], ")"}], "*", 
     RowBox[{"(", 
