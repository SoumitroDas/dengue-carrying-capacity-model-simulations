     RowBox[{"(", 
      RowBox[{"alpm", "+", 
       RowBox[{"(", 
        RowBox[{"mum", "*", 
         RowBox[{"(", 
          RowBox[{"\[ExponentialE]", "^", 
           RowBox[{"(", "W", ")"}]}], ")"}]}], ")"}]}], ")"}]}]]]}]}], "Input",
