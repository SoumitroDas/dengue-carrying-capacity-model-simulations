Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Ro", "[", 
    RowBox[{"A_", ",", "W_"}], "]"}], "=", 
   SqrtBox[
    FractionBox[
     RowBox[{"Lm", "*", "Lh", "*", "bh", "*", 
      RowBox[{"(", 
       RowBox[{"\[ExponentialE]", "^", 
        RowBox[{"-", 
         RowBox[{"(", "A", ")"}]}]}], ")"}], "*", "bm", "*", 
      RowBox[{"(", 
       RowBox[{"\[ExponentialE]", "^", 
        RowBox[{"-", 
         RowBox[{"(", "A", ")"}]}]}], ")"}], "*", "alph", "*", "alpm", "*", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"(", 
         FractionBox["12.58", 
          RowBox[{"K", "*", 
           RowBox[{"(", 
            RowBox[{"\[ExponentialE]", "^", 
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{"W", "+", "A"}], ")"}]}]}], ")"}]}]], ")"}]}], ")"}]}], 
     RowBox[{"mum", "*", 
      RowBox[{"(", 
       RowBox[{"\[ExponentialE]", "^", 
        RowBox[{"(", "W", ")"}]}], ")"}], "*", "muh", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"mum", "*", 
          RowBox[{"(", 
           RowBox[{"\[ExponentialE]", "^", 
            RowBox[{"(", "W", ")"}]}], ")"}]}], ")"}], "+", "phim"}], ")"}], 
      "*", 
      RowBox[{"(", 
       RowBox[{"muh", "+", "phih", "+", "gh"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"alph", "+", "muh"}], ")"}], "*", 
      RowBox[{"(", 
       RowBox[{"alpm", "+", 
        RowBox[{"(", 
         RowBox[{"mum", "*", 
          RowBox[{"(", 
           RowBox[{"\[ExponentialE]", "^", 
            RowBox[{"(", "W", ")"}]}], ")"}]}], ")"}]}], ")"}]}]]]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"R0sym", "=", 
   RowBox[{"Ro", "[", 
    RowBox[{"A", ",", "W"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.976440088353346*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"76259d39-3547-5741-9591-95d4e2a533e6"],

Cell[BoxData[
 SqrtBox[
  FractionBox[
   RowBox[{"alph", " ", "alpm", " ", "bh", " ", "bm", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], " ", "A"}], "-", "W"}]], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"12.58`", " ", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"A", "+", "W"}]]}], "K"]}], ")"}], " ", "Lh", " ", "Lm"}], 
   RowBox[{"muh", " ", 
    RowBox[{"(", 
     RowBox[{"alph", "+", "muh"}], ")"}], " ", "mum", " ", 
    RowBox[{"(", 
     RowBox[{"alpm", "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", "W"], " ", "mum"}]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"gh", "+", "muh", "+", "phih"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", "W"], " ", "mum"}], "+", "phim"}], 
     ")"}]}]]]], "Output",
